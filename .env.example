# g-brain configuration. Every variable is read once at startup and validated.
# The canonical explanation of each is docs/technical/02-tech-stack.md.

# WHERE THE BRAIN LIVES.
# Defaults to ~/brain. Anchored to $HOME, never to the current directory.
#
# WARNING: BRAIN_ROOT must never point inside a source code repository.
# With GIT_AUTOCOMMIT on, an agent's captures would be committed into that
# project's working tree. The server refuses to start if it detects this.
BRAIN_ROOT=

# Commit every write to the brain repo. Off by default: writing to a repository
# is a side effect nobody should get unasked. Turn it off for bulk import.
GIT_AUTOCOMMIT=false

# Commits are authored as: agent-name <agent@g-brain.local>
GIT_AUTHOR_SUFFIX=@g-brain.local

# Quiet period after the last write before one commit covers the whole burst.
GIT_DEBOUNCE_MS=2000

# stdio for local MCP clients, http for remote ones.
MCP_TRANSPORT=stdio
MCP_HTTP_PORT=8787

# Defaults to true for http and false for stdio. stdio is a local child process
# the client already controls; http is not.
AUTH_REQUIRED=

# 256 kB. A larger body is a malfunction or a dumped log, not a capture.
MAX_DOC_BYTES=262144

# Token bucket per key. A guard against a runaway loop, not against an attacker.
RATE_LIMIT_PER_MINUTE=120

# Trigram similarity for near-duplicate detection. Lowering it starts rejecting
# legitimate writes, which is the expensive direction.
DUPLICATE_THRESHOLD=0.9

# 8 MiB, then audit.jsonl rotates by rename. Never by truncation.
AUDIT_MAX_BYTES=8388608
AUDIT_KEEP=8

# The folder projects live under, and therefore the project access boundary.
# Presets disagree: `default` says 20-projects, `personal` says projects. Core
# cannot read the name out of content-structure.md without parsing it for
# meaning, which ADR-0001 rejects, so it is configured here.
PROJECTS_FOLDER=20-projects

# The seam hybrid retrieval arrives through. Lexical is the only v1 value.
SEARCH_MODE=lexical

# Reported by `gbrain doctor`. Expiry archives; it never deletes.
SESSION_EXPIRY_DAYS=90
